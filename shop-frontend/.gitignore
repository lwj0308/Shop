# 依赖目录
node_modules/
dist/

# 编辑器配置
.vscode/*
!.vscode/extensions.json
.idea/

# 操作系统文件
.DS_Store
Thumbs.db

# 环境变量文件（包含敏感信息，不提交）
*.local

# 日志文件
*.log
npm-debug.log*
pnpm-debug.log*

# 构建产物
*.tsbuildinfo

# 测试产物（运行时生成，不入库）
# Vitest 覆盖率报告
coverage/
# Playwright E2E 测试报告和测试结果
playwright-report/
test-results/
